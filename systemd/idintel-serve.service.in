[Unit]
Description=ID Intelligence — report + Zotero archive server
After=network-online.target
Wants=network-online.target

[Service]
# Long-running server (not oneshot): serves the reports at http://localhost:8791
# and handles the "＋ Zotero" archive buttons.
Type=simple
WorkingDirectory=@APP_DIR@
ExecStart="@APP_DIR@/idintel.sh" serve --host 127.0.0.1 --port 8791
StandardOutput=append:@APP_DIR@/logs/serve.log
StandardError=append:@APP_DIR@/logs/serve.log
# Restart if it ever crashes, with a short back-off.
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
