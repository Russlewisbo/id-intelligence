[Unit]
Description=ID Intelligence — report + Zotero archive server
After=network-online.target
Wants=network-online.target

[Service]
# Long-running server (not oneshot): serves the reports at http://localhost:8791
# and handles the "＋ Zotero" archive buttons.
Type=simple
WorkingDirectory=/home/ussellr/Desktop/ID app
ExecStart="/home/ussellr/Desktop/ID app/idintel.sh" serve --host 127.0.0.1 --port 8791
StandardOutput=append:/home/ussellr/Desktop/ID app/logs/serve.log
StandardError=append:/home/ussellr/Desktop/ID app/logs/serve.log
# Restart if it ever crashes, with a short back-off.
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
