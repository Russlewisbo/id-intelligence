[Unit]
Description=ID Intelligence — daily digest
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The project path contains a space, so both the working directory and the
# executable must stay quoted.
WorkingDirectory=/home/ussellr/Desktop/ID app
ExecStart="/home/ussellr/Desktop/ID app/idintel.sh" daily
StandardOutput=append:/home/ussellr/Desktop/ID app/logs/daily.log
StandardError=append:/home/ussellr/Desktop/ID app/logs/daily.log
# Collection plus up to 35 AI appraisals; generous ceiling before systemd kills it.
TimeoutStartSec=5400
Nice=10
